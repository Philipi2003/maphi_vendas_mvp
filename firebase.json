{
  "functions": {
    "source": "functions",
    "runtime": "python313",
    "ignore": [
      ".venv",
      "venv",
      "__pycache__",
      "*.pyc",
      ".env*",
      ".secret.local",
      ".pytest_cache",
      "test_*.py"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
